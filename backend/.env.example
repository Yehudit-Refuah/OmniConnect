# Copy this file to .env and fill in real values. Never commit .env.

# Secret key the PBX sends in the X-API-Key header.
# Make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
PBX_API_KEY=put-a-long-random-key-here

# IP addresses allowed to call the PBX endpoints, separated by commas.
# 127.0.0.1 and ::1 = your own PC (for testing).
PBX_ALLOWED_IPS=127.0.0.1,::1

# Claude: keep OFF until IT/compliance confirm the BAA
#CLAUDE_INTENT_ENABLED=false
#ANTHROPIC_API_KEY=
#CLAUDE_INTENT_MODEL=claude-opus-5-5

# AI for unclear replies: "off" or "grok". Keep OFF until the BAA check is done.
INTENT_AI_PROVIDER=off
XAI_API_KEY=
XAI_INTENT_MODEL=grok-4.20-0309-non-reasoning