# Copy this file to .env and fill in real values. Never commit .env.

# Secret key the PBX sends in the X-API-Key header.
# Make one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
PBX_API_KEY=put-a-long-random-key-here

# IP addresses allowed to call the PBX endpoints, separated by commas.
# 127.0.0.1 and ::1 = your own PC (for testing).
PBX_ALLOWED_IPS=127.0.0.1,::1
